# Firebase → Project settings → General → Your apps → Web app → SDK config
# Only needed for local dev with login (copy to .env.local). The deployed site on Firebase Hosting
# reads its config automatically from /__/firebase/init.json.
# Without these the app runs in "local mode" (no login, progress stored in this browser only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Free AI check (Gemini via Firebase AI Logic) needs App Check.
# Firebase → Security → App Check → register the web app with reCAPTCHA Enterprise → copy the SITE key here.
# Put it in .env.local (dev) and .env.production (used by `npm run deploy`). It is a public key, not a secret.
VITE_RECAPTCHA_SITE_KEY=
